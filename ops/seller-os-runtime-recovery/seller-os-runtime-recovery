#!/usr/bin/env bash
set -euo pipefail

RUNTIME_ENV="/home/earch/.config/imnova/seller-os-cloud-read-relay.env"

source "$RUNTIME_ENV"

RECOVERY_ORIGIN="${SELLER_OS_RUNTIME_RECOVERY_ORIGIN:-http://127.0.0.1:3100}"
RECOVERY_URL="${RECOVERY_ORIGIN%/}/api/cron/quick-pick-runtime-recovery"

curl --fail-with-body --silent --show-error --max-time 310 \
  --request POST \
  --header "x-seller-os-runtime-recovery-secret: ${SELLER_OS_RUNTIME_RECOVERY_SECRET}" \
  --output /dev/null \
  "$RECOVERY_URL"

unset SELLER_OS_RUNTIME_RECOVERY_SECRET 2>/dev/null || true
