# Copy to /etc/seller-os/backup.env, enter values locally, then:
# sudo chown root:root /etc/seller-os/backup.env
# sudo chmod 0600 /etc/seller-os/backup.env
#
# Format is literal KEY=value. Do not add shell quotes or commands. Percent-
# encode special characters in the PostgreSQL URL.

SELLER_OS_BACKUP_SOURCE_DATABASE_URL=
SELLER_OS_BACKUP_SOURCE_LABEL=
SELLER_OS_BACKUP_GPG_RECIPIENT=
SELLER_OS_BACKUP_DIR=
SELLER_OS_BACKUP_RETENTION_DAYS=
