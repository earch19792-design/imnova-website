# Copy to /etc/seller-os/restore.env, enter values for a NEW empty destination,
# then make the file root-only. Never reuse the source URL.
#
# Format is literal KEY=value. Do not add shell quotes or commands. Percent-
# encode special characters in the PostgreSQL URL.

SELLER_OS_RESTORE_DESTINATION_DATABASE_URL=
SELLER_OS_RESTORE_DESTINATION_LABEL=
# Keep blank for normal disaster-recovery targets. A deliberately Production-
# labelled empty target requires the separate acknowledgement described in the
# README; the script still requires the full typed per-backup confirmation.
SELLER_OS_RESTORE_ALLOW_PRODUCTION=
