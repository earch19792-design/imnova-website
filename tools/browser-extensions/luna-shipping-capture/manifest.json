{
  "manifest_version": 3,
  "name": "Seller OS — Luna Shipping Capture",
  "version": "1.0.29",
  "description": "Captura únicamente cotizaciones visibles de envío Luna para candidatos exactos de Seller OS.",
  "key": "",
  "permissions": ["scripting", "webNavigation", "storage"],
  "host_permissions": [
    "https://lunaportex.com/*",
    "https://www.lunaportex.com/*",
    "https://account.lunaportex.com/*",
    "https://shop.app/*"
  ],
  "externally_connectable": {
    "matches": [
      "https://imnova-website-z1qh-git-featur-6c9e25-earch19792-6888s-projects.vercel.app/*"
    ]
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://lunaportex.com/*",
        "https://www.lunaportex.com/*",
        "https://account.lunaportex.com/*",
        "https://shop.app/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
