  "smokeTestSummary": "This smoke test validates the seller operating flow before real image execution or eBay Sandbox. It confirms that each product falls into one primary operational queue. It confirms out_of_stock wins over sell-now signals. It confirms Listing uses Pipeline decision by reference and does not recalculate profitability. It does not create drafts, publish listings, generate images, upload images or call eBay.",
  "routingRules": {
    "onePrimaryQueuePerProduct": true,
    "queuePriority": [
      "Sin stock",
      "Proteger",
      "Revisar stock",
      "Margen",
      "Bloqueados",
      "Vender ahora",
      "Monitorear"
    ],
    "outOfStockBeatsSellNow": true,
    "sellNowRequiresStockConfirmed": true,
    "listingUsesPipelineDecisionByReference": true,
    "listingDoesNotDuplicateProfitabilityTruth": true,
    "listingDoesNotRecalculateMargin": true,
    "listingDoesNotRecalculateDemand": true,
    "listingDoesNotRecalculateCompetition": true
  },
  "testScenarios": [
    {
      "scenarioId": "kerasys_out_of_stock_confirmed",
      "productName": "Kerasys",
      "radarSignal": "out_of_stock_confirmed",
      "stockStatus": "out_of_stock",
      "stockConfirmed": false,
      "pipelineDecision": "do_not_sell_now",
      "expectedPrimaryQueue": "Sin stock",
      "mustNotAppearIn": [
        "Vender ahora"
      ],
      "listingAllowed": false,
      "reason": "Confirmed out_of_stock must route to Sin stock and cannot appear as sell-now."
    },
    {
      "scenarioId": "stock_confirmed_profitable_sell_now",
      "productName": "Storage Organizer",
      "supplier": "Portex",
      "radarSignal": "opportunity_detected",
      "stockStatus": "in_stock",
      "stockConfirmed": true,
      "profitStatus": "margin_ok",
      "pipelineDecision": "candidate_for_listing",
      "expectedPrimaryQueue": "Vender ahora",
      "listingAllowed": true,
      "reason": "Sell-now requires confirmed stock and acceptable margin."
    },
    {
      "scenarioId": "unknown_stock_needs_review",
      "productName": "Catalog Product Unknown Stock",
      "stockStatus": "unknown",
      "stockConfirmed": false,
      "pipelineDecision": "needs_stock_review",
      "expectedPrimaryQueue": "Revisar stock",
      "listingAllowed": false,
      "reason": "Unknown stock must be reviewed before sell-now."
    },
    {
      "scenarioId": "margin_missing_needs_margin_review",
      "productName": "Margin Review Product",
      "stockStatus": "in_stock",
      "stockConfirmed": true,
      "profitStatus": "missing_margin_data",
      "pipelineDecision": "needs_margin_review",
      "expectedPrimaryQueue": "Margen",
      "listingAllowed": false,
      "reason": "Missing margin data blocks sell-now."
    },
    {
      "scenarioId": "risk_blocked_product",
      "productName": "Risk Blocked Product",
      "riskStatus": "blocked",
      "pipelineDecision": "blocked",
      "expectedPrimaryQueue": "Bloqueados",
      "listingAllowed": false,
      "reason": "Risk/compliance blocker must prevent advancement."
    },
    {
      "scenarioId": "monitor_only_product",
      "productName": "Monitor Only Product",
      "stockStatus": "in_stock",
      "stockConfirmed": true,
      "profitStatus": "low_signal",
      "pipelineDecision": "monitor",
      "expectedPrimaryQueue": "Monitorear",
      "listingAllowed": false,
      "reason": "Low signal stays in monitor queue."
    }
  ],
  "expectedResults": {
    "allScenariosHaveOnePrimaryQueue": true,
    "kerasysOutOfStockRoutesToSinStock": true,
    "outOfStockNeverRoutesToSellNow": true,
