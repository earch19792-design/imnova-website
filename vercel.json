{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "app/api/queues/ebay-listing-top20-continuation/route.ts": {
      "experimentalTriggers": [
        {
          "type": "queue/v2beta",
          "topic": "ebay-listing-top20-continuation",
          "retryAfterSeconds": 15,
          "initialDelaySeconds": 0
        }
      ]
    }
  },
  "crons": [
    {
      "path": "/api/cron/ebay-commercial-monitor-schedule",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/cron/commercial-alert-dispatcher-schedule",
      "schedule": "* * * * *"
    },
    {
      "path": "/api/cron/ebay-owner-sale-alerts-schedule",
      "schedule": "*/5 * * * *"
    }
  ]
}
