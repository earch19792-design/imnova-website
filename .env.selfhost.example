# Safe, non-secret local overrides. Copy to .env.selfhost.local and keep the
# resulting file untracked. Existing credentials remain in .env.local.
SELFHOST_HTTP_PORT=3100

# Automation remains a dry run until the local runtime, public ingress and
# Supabase scheduler bindings have all been validated.
LOCAL_SCHEDULER_DRY_RUN=true

# Required only before enabling the automation profile. Use a new random value
# of at least 32 characters; never reuse a marketplace or Supabase credential.
CRON_SECRET=

# Directory containing config.yml and the locally managed tunnel credential JSON.
# Keep this directory outside Git. The default is ./.cloudflared.
CLOUDFLARED_CONFIG_DIR=.cloudflared
